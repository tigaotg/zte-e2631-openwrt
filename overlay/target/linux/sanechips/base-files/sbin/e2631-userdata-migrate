#!/bin/sh
# E2631 configuration migration is intentionally fail-closed in public Beta.
#
# The previous staging prototype used BusyBox cp -a, which cannot be relied
# on to preserve OverlayFS character-device whiteouts and trusted xattrs.
# It also promoted upper/work non-atomically. It must never be used as a
# production migration or boot activation path.
#
# The original implementation remains available in Git history for design
# review; no unsafe opt-in bypass is provided here.
echo "REFUSED_MIGRATION_NOT_METADATA_SAFE"
echo "No data was copied, erased, formatted or activated."
echo "See docs/BETA-READINESS.md for the migration acceptance requirements."
exit 1
